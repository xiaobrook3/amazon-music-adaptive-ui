{
  "expo": {
    "name": "Amazon Music - Adaptive UI V3",
    "slug": "amazon-music-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C1B22",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1B22"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prototype.amazonmusic",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.prototype.amazonmusic",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#25D1DA"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1B22",
          "image": "./assets/splash.png"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "scheme": "amazonmusic",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2644ec92-8706-483c-b295-f58cb8c3f413"
      }
    },
    "owner": "rabiats"
  }
}
